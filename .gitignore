# ---------------------------------------------------------------------------
dist/
build/
out/
coverage/
.nyc_output/
*.tsbuildinfo
*.lcov
.eslintcache
.stylelintcache
.cache/
.tmp/
tmp/
temp/
*.tmp
*.temp
*.bak

# ---------------------------------------------------------------------------
# Test artifacts and reports
# ---------------------------------------------------------------------------
test-results/
playwright-report/
junit*.xml
*.test.log
*.spec.log

# Local-only development tests: kept on the author's machine, never committed
# or published (the npm package's `files` list also excludes them).
test/

# ---------------------------------------------------------------------------
# Logs and crash dumps
# ---------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.pid.lock
core
core.*
hs_err_pid*.log

# ---------------------------------------------------------------------------
# Agent instruction files (local only, never committed)
# ---------------------------------------------------------------------------
AGENTS.md
CLAUDE.md

# ---------------------------------------------------------------------------
# Internal project documents (kept local, not part of the public repository)
# ---------------------------------------------------------------------------
PUBLISHING.md

# ---------------------------------------------------------------------------
# Local runtime data and settings (never publish a developer's machine state)
# ---------------------------------------------------------------------------
.dsh/
dsh-quotaline-settings.json
settings.local.json
*.local
*.local.*

# ---------------------------------------------------------------------------
# Environment variables, credentials, key material
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.credentials.yaml
credentials.json
secrets.json
*.pem
*.key
*.p12
*.pfx

# ---------------------------------------------------------------------------
# Editor and IDE state
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
*.swp
*.swo
*~
.cursor/
.history/

# ---------------------------------------------------------------------------
# Operating system metadata
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

