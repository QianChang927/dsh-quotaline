{
  "name": "dsh-quotaline",
  "version": "0.2.1",
  "description": "Model quota / balance strip above the composer for DeepSeek Harness — reads local credentials read-only, no API key prompts.",
  "type": "module",
  "license": "MIT",
  "author": "QianChang927",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "quota",
    "balance",
    "usage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QianChang927/dsh-quotaline.git"
  },
  "homepage": "https://github.com/QianChang927/dsh-quotaline#readme",
  "bugs": {
    "url": "https://github.com/QianChang927/dsh-quotaline/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
